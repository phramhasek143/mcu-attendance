# ==============================================================================
# MCU Smart Attendance System - Environment Variables Template
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MCU-SAMS (MCU Student Attendance Management System)"

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://mcu_admin:mcu_password@localhost:5432/mcu_attendance?schema=public"

# In-Memory Cache & Token Store (Redis 7)
REDIS_URL="redis://localhost:6379"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-32-byte-secret-key-here-with-openssl-rand-hex-32"

# Dynamic QR Security Key (HMAC-SHA256 Secret)
QR_HMAC_SECRET="generate-a-secure-random-hmac-secret-key-here"

# Object Storage (MinIO / S3 for Leave Documents)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="mcu-attendance-documents"

# Campus Integration (Optional for MVP Stage)
MCU_LDAP_URL="ldap://ldap.mcu.ac.th:389"
MCU_SIS_API_URL="https://reg.mcu.ac.th/api/v1"
